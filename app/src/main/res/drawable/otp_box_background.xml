<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/otp_box_bg" />
            <stroke android:width="2dp" android:color="@color/primary" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Filled state (has text) -->
    <item android:state_enabled="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/otp_box_bg" />
            <stroke android:width="1.5dp" android:color="@color/otp_box_stroke" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke android:width="1.5dp" android:color="@color/divider" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
